APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
API_DOMAIN=

# SEO Settings - set to false on test/staging environments
ROBOTS_ALLOW_INDEXING=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Wie lange ein Job als "in Bearbeitung" gilt, bevor die Queue ihn erneut
# ausliefert (Sekunden). Muss GROESSER sein als das --timeout des Workers,
# sonst wird ein noch laufender Job ein zweites Mal gestartet.
# Beispiel: Worker mit --timeout=300 -> DB_QUEUE_RETRY_AFTER=330
DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Entry Conditions / Passolution API Configuration
PASSOLUTION_API_URL=https://api.passolution.com
# Basis-URL fuer die internen __internal-Service-Token-Endpunkte (Service api-internal)
PASSOLUTION_INTERNAL_API_URL=https://api-internal-dot-pds-prod-dataservice.appspot.com/api/v2
PASSOLUTION_WEB_URL=https://web.passolution.de
PASSOLUTION_HELP_CENTER_URL=https://web.passolution.de/zoho/desk/saml/login
# Shared secret zum Signieren des iframe-SSO-Tokens (identisch in pds-homepage)
IFRAME_SSO_SECRET=
# Optionale Query-Parameter, die an die iframe-URL /auth/sso/check angehaengt
# werden, z. B. UI-Hide-Flags der pds-Homepage:
# PASSOLUTION_IFRAME_UI_PARAMS=menu-hide=gtm,hc,is&ui-hide=is
PASSOLUTION_IFRAME_UI_PARAMS=
PDS_KEY=your_api_key_here
ENTRY_CONDITIONS_ENABLED=true
ENTRY_CONDITIONS_LOGGING_ENABLED=false
ENTRY_CONDITIONS_AVAILABLE_NATIONALITIES=DE,AT,CH

# Event Translations (mehrsprachige Events)
# EVENT_LANGUAGES: kommagetrennte Sprach-/Länderkürzel (2-stellige ISO-Codes)
# EVENT_SOURCE_LANGUAGE: Ausgangssprache (wird per DeepL übersetzt, Fallback der Anzeige)
EVENT_LANGUAGES=de,en,nl
EVENT_SOURCE_LANGUAGE=de
# Sichtbarer Sprachumschalter im Frontend-Header (true = anzeigen)
EVENT_LANGUAGE_SWITCHER_ENABLED=false

# DeepL Übersetzungs-API (Pro). Ohne Key bleibt der "Übersetzen"-Button inaktiv.
DEEPL_KEY=
DEEPL_API_URL=https://api.deepl.com/v2/translate

# VisumPoint API Configuration
VISUMPOINT_ENABLED=true
VISUMPOINT_ORGANIZATION=your_organization_here
VISUMPOINT_ACCESS_TOKEN=your_access_token_here
VISUMPOINT_BASE_URL=https://www.visumpoint.de/REST/ComplianceCheck/API.php

# Dashboard Feature Toggles
DASHBOARD_AIRPORTS_ENABLED=true
DASHBOARD_BOOKING_ENABLED=true

# Customer Authentication
CUSTOMER_REGISTRATION_ENABLED=true
CUSTOMER_LOGIN_ENABLED=true

# Navigation Menu Configuration
NAVIGATION_MENU_ENABLED=true
# Optionale externe URL fuer das 1. Symbol (Travel Requirements Service).
# Wenn gesetzt, oeffnet das Symbol diese URL in einem neuen Tab; sonst interne Route.
NAVIGATION_TRS_EXTERNAL_URL=
NAVIGATION_EVENTS_ENABLED=true
NAVIGATION_ENTRY_CONDITIONS_ENABLED=true
NAVIGATION_BOOKING_ENABLED=true
NAVIGATION_AIRPORTS_ENABLED=true
NAVIGATION_BRANCHES_ENABLED=true
NAVIGATION_MY_TRAVELERS_ENABLED=true
NAVIGATION_RISK_OVERVIEW_ENABLED=true
NAVIGATION_CRUISE_ENABLED=true
NAVIGATION_CENTER_MAP_ENABLED=true

# TravelAlert Preishinweis auf der Promoseite (Bestellmodal, Zusammenfassung,
# Structured Data). Einfaches HTML ist erlaubt. Leer lassen, um den Hinweis
# komplett zu entfernen – die Preisangaben selbst bleiben bestehen:
# TRAVEL_ALERT_PRICE_NOTICE=
TRAVEL_ALERT_PRICE_NOTICE="Die Zusatzleistung TravelAlert wird <strong>bis zum 30.06.2026 kostenlos</strong> zur Verfügung gestellt. In diesem Zeitraum kann jederzeit per Mail an <a href=\"mailto:info@passolution.de\" class=\"text-blue-600 underline\">info@passolution.de</a> der Vertrag gekündigt werden."

# TravelAlert Bestellfreigabe: Der Kunde bestaetigt jede Bestellung per Mail.
# true  = Zugang ist mit der Bestaetigung sofort frei
# false = ein Mitarbeiter schaltet die Bestellung im Backend frei
TRAVEL_ALERT_AUTO_ACTIVATION=true
# Gueltigkeit des Bestaetigungslinks in Tagen
TRAVEL_ALERT_CONFIRMATION_EXPIRE_DAYS=7
# Ziel des "Kunde im Admin-Bereich oeffnen"-Links in der internen Bestellmail.
# Leer  = lokaler Filament-Bereich (/admin/customers/{id}).
# Basis-URL (ID wird angehaengt) ODER Vorlage mit Platzhalter {id}:
#   TRAVEL_ALERT_ADMIN_CUSTOMER_URL=https://admin.example.com/customers
#   TRAVEL_ALERT_ADMIN_CUSTOMER_URL=https://admin.example.com/kunde?id={id}
TRAVEL_ALERT_ADMIN_CUSTOMER_URL=
# Ziel der "Jetzt bestellen"-Buttons auf der TravelAlert-Promoseite (/travel-alert).
# Leer     = das eingebaute Bestell-Popup wird geoeffnet (Standard).
# Gesetzt  = die URL wird stattdessen in einem neuen Tab geoeffnet:
#   TRAVEL_ALERT_ORDER_URL=https://platform.passolution.de/travel-alert?user-state=logged-in
TRAVEL_ALERT_ORDER_URL=

# Authentication Configuration
AUTHENTICATION_ENABLED=true

# Customer Authentication Configuration
CUSTOMER_REGISTRATION_ENABLED=true
CUSTOMER_EMAIL_VERIFICATION_REQUIRED=true
CUSTOMER_2FA_ENABLED=true

# Social Login Configuration
# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL="${APP_URL}/customer/auth/facebook/callback"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/customer/auth/google/callback"

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URL="${APP_URL}/customer/auth/linkedin/callback"

# Twitter (X) OAuth
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URL="${APP_URL}/customer/auth/twitter/callback"

# ============================================
# SSO-Treiber-Auswahl
# ============================================
# Welcher Socialite-Treiber den Login-Flow abwickelt:
#   keycloak        = Passolution Keycloak (OIDC)               [Standard]
#   laravelpassport = Passolution Laravel Passport (OAuth2)
# Keycloak deaktivieren = SSO_DRIVER=laravelpassport setzen.
SSO_DRIVER=keycloak
# true = SSO ist der einzige Login-Weg, /customer/login leitet direkt weiter.
# false = Login-Seite mit E-Mail/Passwort + SSO-Button anzeigen (Standard).
SSO_FORCE_REDIRECT=false

# Keycloak OIDC (Passolution SSO) – aktiv bei SSO_DRIVER=keycloak
OIDC_BASE_URL=https://auth.passolution.de
OIDC_CLIENT_ID=platform-passolution
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI="${APP_URL}/auth/callback"
OIDC_LOGOUT_REDIRECT_URI="${APP_URL}"

# Laravel Passport (Socialite) – aktiv bei SSO_DRIVER=laravelpassport
# OAuth-Client (Client ID + Secret) im Backend anlegen. Redirect-URI muss mit
# der Plattform-URL uebereinstimmen (gleicher Callback wie Keycloak: /auth/callback).
# Endpunkte relativ zu SSO_HOST: /oauth/authorize, /oauth/token, /api/user.
SSO_HOST=https://auth.homepage-test.passolution.de
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI="${APP_URL}/auth/callback"
# 'prompt=login' beim Login anhaengen (frische Anmeldung erzwingen; nur wirksam,
# wenn der Auth-Server den Parameter unterstuetzt).
SSO_PROMPT_LOGIN=true
# Optionaler Logout-/End-Session-Endpunkt des Auth-Servers. Wenn gesetzt, wird der
# Nutzer beim Logout dorthin geleitet (beendet auch die Provider-Session).
SSO_LOGOUT_URL=
# Optional: Ziel nach Logout (Standard: Login-Seite)
SSO_LOGOUT_REDIRECT_URI="${APP_URL}"

# Keycloak Admin REST API – Service Account (client_credentials grant).
# Dedizierter confidential Client mit serviceAccountsEnabled, dem auf dem
# passolution-Realm die realm-management Rollen manage-users + view-users
# zugewiesen sind. Ersetzt den alten admin-cli Passwort-Login (master-Realm).
KEYCLOAK_ADMIN_CLIENT_ID=platform-passolution-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ============================================
# SSO Configuration (Service Provider)
# ============================================
SSO_VERSION=1.2.0
# Public key is stored in file: storage/app/sso/sso-public.key
# No environment variable needed when SSO_USE_ENV_KEYS=false
SSO_USE_ENV_KEYS=false

# ============================================
# Travel Detail Module Configuration
# ============================================
# Feature Toggle
TD_FEATURE_ENABLED=true

# PDS API Integration (for share links)
PDS_API_URL=http://127.0.0.1:8002
PDS_API_KEY=your_pds_api_key_here
PDS_API_TIMEOUT=30
TD_PDS_SHARE_LINK_ENABLED=true

# API Configuration
TD_API_RATE_LIMIT=100
TD_API_RATE_LIMIT_WINDOW=60

# Archival Configuration
TD_ARCHIVE_ENABLED=true
TD_ARCHIVE_DAYS=30
TD_ARCHIVE_BATCH_SIZE=1000
TD_ARCHIVE_USE_SEPARATE_DB=false

# Archive Database (optional, only if TD_ARCHIVE_USE_SEPARATE_DB=true)
# TD_ARCHIVE_DB_HOST=127.0.0.1
# TD_ARCHIVE_DB_PORT=3306
# TD_ARCHIVE_DB_DATABASE=travel_detail_archive
# TD_ARCHIVE_DB_USERNAME=root
# TD_ARCHIVE_DB_PASSWORD=

# Proximity Query Settings
TD_PROXIMITY_DEFAULT_RADIUS_KM=100
TD_PROXIMITY_MAX_RADIUS_KM=500

# Transfer Detection
TD_TRANSFER_MIN_MINUTES=30
TD_TRANSFER_MAX_MINUTES=2880
TD_TIGHT_CONNECTION_MINUTES=60

# Caching
TD_CACHE_AIRPORT_TTL=3600
TD_CACHE_COUNTRY_TTL=86400

# Logging
TD_LOGGING_ENABLED=true
TD_LOG_CHANNEL=travel_detail
TD_LOG_PAYLOADS=false
TD_IMPORT_LOG_RETENTION_DAYS=90

# Data Retention & Cleanup
TD_PURGE_ARCHIVED_YEARS=2
TD_SCHEDULED_CLEANUP_ENABLED=true
TD_CLEANUP_TIME=03:00

# Notification Queues (Intervall in Minuten)
GTM_NOTIFICATION_INTERVAL=5
TRAVEL_ALERT_NOTIFICATION_INTERVAL=5
NOTIFICATION_LOOKBACK_HOURS=24
TRAVEL_LINKS_SYNC_INTERVAL=30

# Debug Panel (comma-separated email addresses)
DEBUG_EMAILS=
# Debug Panel global an/aus fuer ALLE Nutzer (true/false), unabhaengig von DEBUG_EMAILS
TRAVEL_ALERT_DEBUG=false
# Dashboard-Bereich "Profil vervollstaendigen" global ausblenden (true/false)
HIDE_PROFILE_COMPLETION=false
# Dashboard: Block "Status" anzeigen / "Funktionen"-Zeile im Block "Konto" anzeigen
DASHBOARD_STATUS_ENABLED=true
DASHBOARD_KONTO_FUNKTIONEN_ENABLED=true
# Dashboard: Firmen-Boxen (Firmenadresse / Rechnungsadresse / Filialen) anzeigen
DASHBOARD_BUSINESS_BOXES_ENABLED=true

# Customer Settings – Bereiche ein-/ausblenden (Sidebar + Direktzugriff via URL)
CUSTOMER_SETTINGS_GENERAL_ENABLED=true
CUSTOMER_SETTINGS_MASTER_DATA_ENABLED=true
CUSTOMER_SETTINGS_ORGANIZATION_ENABLED=true
CUSTOMER_SETTINGS_USERS_ENABLED=true
CUSTOMER_SETTINGS_TRAVEL_REQUIREMENTS_ENABLED=true
CUSTOMER_SETTINGS_GTM_ENABLED=true
CUSTOMER_SETTINGS_TRAVEL_ALERT_ENABLED=true
CUSTOMER_SETTINGS_TRAVEL_DATA_ENABLED=true
CUSTOMER_SETTINGS_TRAVEL_LINK_ENABLED=true
CUSTOMER_SETTINGS_TRAVEL_INFORMATION_ENABLED=true
CUSTOMER_SETTINGS_CONNECTED_SERVICES_ENABLED=true

# Customer Settings – einzelne Blöcke
CUSTOMER_SETTINGS_PASSWORD_CHANGE_ENABLED=true
# "Produktaktivierung" im Bereich Travel Requirements Service
CUSTOMER_SETTINGS_PRODUCT_ACTIVATION_ENABLED=true
